<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://yourdomain.com/Nama30TV" version="1.3.0" viewmodes="maximized">
  <tizen:application id="Nama30TvAp.Nama30TV" package="Nama30TvAp" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <feature name="http://tizen.org/feature/web.service" required="false"/>
  <icon src="icon.png"/>
  <name>30nama</name>
  <author>personal</author>
  <description>Unofficial 30nama client for Samsung Tizen TV</description>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <access origin="*" subdomains="true"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
  <!-- Smart Hub Preview: rows above the app tile, supplied by PreviewService (js/preview.js builds them) -->
  <tizen:metadata key="http://samsung.com/tv/metadata/use.preview" value="bg_service"/>
  <!-- a preview tile click reaches the running app without reloading it (appcontrol event) -->
  <tizen:app-control>
    <tizen:src name="index.html" reload="disable"/>
    <tizen:operation name="http://samsung.com/appcontrol/operation/eden_resume"/>
  </tizen:app-control>
  <tizen:service id="Nama30TvAp.PreviewService" auto-restart="false">
    <tizen:content src="service/preview.js"/>
    <tizen:name>30namaPreview</tizen:name>
    <tizen:description>Smart Hub Preview rows</tizen:description>
    <tizen:category name="http://tizen.org/category/service"/>
  </tizen:service>
  <tizen:service id="Nama30TvAp.TakeoverService">
    <tizen:content src="service/takeover.js"/>
    <tizen:name>30namaTakeover</tizen:name>
    <tizen:description>Remote button takeover</tizen:description>
  </tizen:service>
</widget>
